  {
   "id": "5954572",
   "type": "status_update",
   "attributes": {
    "message": "An intermittent network issue between Tier 1 network providers one of our cloud provider relies on triggered incidents for customers relying on single-region uptime Monitors. We're sincerely sorry for the trouble. We think this is unacceptable and consider it a priority to make our incident detection even more robust to correctly detect partial intermittent backbone issues. \n\nTo fully mitigate immediately, we recommend enabling more than 1-region for your monitors.\n\nNeed help? Let us know at hello@betterstack.com, we're here for you.",
    "published_at": "2026-10-21T18:30:00.000Z",
    "published_at_timezone": "Pacific Time (US & Canada)",
    "notify_subscribers": false,
    "affected_resources": [
     {
      "status_page_resource_id": "4188756",
      "status": "degraded"
     }
    ]
   }
  },
